{
  "manifest_version": 2,
  "name": "Windows XP",
  "version": "1.0.0",
  "description": "Luna Blue for Firefox, including the sidebar so vertical tabs stay readable.",
  "browser_specific_settings": { "gecko": { "id": "windows-xp@cxc.hojjatabdollahi" } },
  "theme": {
    "images": { "theme_frame": "frame.png", "additional_backgrounds": ["frame.png"] },
    "properties": {
      "additional_backgrounds_alignment": ["top"],
      "additional_backgrounds_tiling": ["repeat-x"],
      "color_scheme": "light",
      "content_color_scheme": "light"
    },
    "colors": {
      "frame": "#0053E3",
      "frame_inactive": "#7A97DF",
      "tab_background_text": "#FFFFFF",
      "tab_selected": "#ECE9D8",
      "tab_text": "#000000",
      "tab_line": "#E68B2C",
      "tab_loading": "#FFC73C",
      "toolbar": "#ECE9D8",
      "toolbar_text": "#000000",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#7F9DB9",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#0053E3",
      "toolbar_field_highlight": "#316AC5",
      "toolbar_field_highlight_text": "#FFFFFF",
      "toolbar_top_separator": "#0053E3",
      "toolbar_bottom_separator": "#ACA899",
      "toolbar_vertical_separator": "#ACA899",
      "icons": "#000000",
      "icons_attention": "#0053E3",
      "button_background_hover": "#FFFFFF",
      "button_background_active": "#D8D4C5",
      "popup": "#FFFFFF",
      "popup_text": "#000000",
      "popup_border": "#ACA899",
      "popup_highlight": "#316AC5",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#6375D6",
      "sidebar_text": "#FFFFFF",
      "sidebar_border": "#ACA899",
      "sidebar_highlight": "#ECE9D8",
      "sidebar_highlight_text": "#000000",
      "ntp_background": "#ECE9D8",
      "ntp_card_background": "#FFFFFF",
      "ntp_text": "#000000"
    }
  }
}
