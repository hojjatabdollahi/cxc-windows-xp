{
  "manifest_version": 2,
  "name": "Windows XP",
  "version": "1.2.0",
  "description": "Windows XP for Firefox, matching the COSMIC bundle: beige window, white sidebar, blue accent. Colours the sidebar so vertical tabs stay readable.",
  "browser_specific_settings": { "gecko": { "id": "windows-xp@cxc.hojjatabdollahi" } },
  "theme": {
    "properties": { "color_scheme": "light", "content_color_scheme": "light" },
    "colors": {
      "frame": "#ECE9D8",
      "frame_inactive": "#ECE9D8",
      "tab_background_text": "#000000",
      "tab_selected": "#DAD6C7",
      "tab_text": "#000000",
      "tab_line": "#316AC5",
      "tab_loading": "#316AC5",
      "toolbar": "#ECE9D8",
      "toolbar_text": "#000000",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#7F9DB9",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#316AC5",
      "toolbar_field_highlight": "#316AC5",
      "toolbar_field_highlight_text": "#FFFFFF",
      "toolbar_top_separator": "#CDCBBA",
      "toolbar_bottom_separator": "#CDCBBA",
      "toolbar_vertical_separator": "#CDCBBA",
      "icons": "#000000",
      "icons_attention": "#316AC5",
      "button_background_hover": "#DAD6C7",
      "button_background_active": "#CDCBBA",
      "popup": "#FBFAF5",
      "popup_text": "#000000",
      "popup_border": "#CDCBBA",
      "popup_highlight": "#316AC5",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#FBFAF5",
      "sidebar_text": "#000000",
      "sidebar_border": "#CDCBBA",
      "sidebar_highlight": "#DAD6C7",
      "sidebar_highlight_text": "#000000",
      "ntp_background": "#ECE9D8",
      "ntp_card_background": "#FBFAF5",
      "ntp_text": "#000000"
    }
  }
}
